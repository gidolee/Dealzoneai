generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum EventType {
  PRODUCT_VIEW
  ADD_TO_CART
  PURCHASE
  SEARCH
  CLICK
}

enum DealStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  fullName       String
  role           UserRole         @default(CUSTOMER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userEvents     UserEvent[]
  recommendations Recommendation[]
  redemptions    Redemption[]
  merchant       Merchant?
}

model Merchant {
  id        String    @id @default(uuid())
  userId    String    @unique
  storeName String
  website   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  deals     Deal[]
}

model Product {
  id          String      @id @default(uuid())
  merchantId  String
  name        String
  description String?
  category    String
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  deals       Deal[]
  events      UserEvent[]
}

model Deal {
  id              String           @id @default(uuid())
  merchantId      String
  productId       String
  title           String
  description     String?
  discountPercent Int
  code            String           @unique
  startsAt        DateTime
  endsAt          DateTime
  status          DealStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  recommendations Recommendation[]
  redemptions     Redemption[]
  metrics         CampaignMetric[]
}

model UserEvent {
  id         String    @id @default(uuid())
  userId      String
  productId   String?
  type        EventType
  metadata    Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
}

model Recommendation {
  id          String   @id @default(uuid())
  userId       String
  dealId       String
  score        Float
  reasoning    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  deal         Deal     @relation(fields: [dealId], references: [id])

  @@unique([userId, dealId])
  @@index([userId, score])
}

model Redemption {
  id            String   @id @default(uuid())
  userId         String
  dealId         String
  orderValue     Decimal  @db.Decimal(10, 2)
  discountValue  Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  deal           Deal     @relation(fields: [dealId], references: [id])

  @@index([dealId, redeemedAt])
}

model CampaignMetric {
  id                String   @id @default(uuid())
  dealId             String
  date               DateTime
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  redemptionsCount   Int      @default(0)
  incrementalRevenue Decimal  @default(0) @db.Decimal(12, 2)
  marginImpact       Decimal  @default(0) @db.Decimal(12, 2)
  deal               Deal     @relation(fields: [dealId], references: [id])

  @@unique([dealId, date])
}
